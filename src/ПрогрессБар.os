///////////////////////////////////////////////////////////////////////////////
// Класс реализации прогресс бара консольных приложений
//
// (C) Maximov Valеry aka TheShadowCo
///////////////////////////////////////////////////////////////////////////////

Перем ТекстПодсказки;
Перем НадоВыводитьПроценты;
Перем НадоВыводитьНомерИКоличество;
Перем НадоВыводитьВремя;
Перем КоличествоШаговПрогресса;
Перем ЦветТекстаКонсоли;

Перем ПоследнийШаг;

Перем Инициализирован;
Перем ДатаНачала;
Перем Длительность;

Перем СтрокаПустогоБара;
Перем СтрокаЗаполненногоБара;
Перем ЦветБара;

Перем КурсорУправляем;
Перем ВыводВозможен;

Перем ДлинаБараПоУмолчанию;
Перем МинимальнаяДлинаБара;

///////////////////////////////////////////////////////////////////////////////

// Начать
//	Выполняет инициализацию прогресс бара
//
// Параметры:
//  КоличествоШагов 			- Число 	- Общее количество шагов прогресса
//	Подсказка 					- Строка 	- Текст, выводимый перед строкой прогресса
//	ВыводитьПроценты 			- Булево 	- Флаг отображения прогресса в процентах (в конце строки)
//	ВыводитьНомерИКоличество 	- Булево 	- Флаг вывода прогресса в абсолютном виде
//	ВыводитьВремя 				- Булево 	- Флаг вывода времени выполнения и прогноза завершения
//
Процедура Начать(КоличествоШагов, Подсказка = "", ВыводитьПроценты = ИСТИНА, ВыводитьНомерИКоличество = ИСТИНА, 
	ВыводитьВремя = ИСТИНА) Экспорт
	
	Попытка

		ЦветТекстаКонсоли = Консоль.ЦветТекста;

	Исключение

		// цвет текста недоступен там же, где и остальная консоль: рисовать будет нечем
		ЦветТекстаКонсоли = ЦветКонсоли.White;
		ВыводВозможен = Ложь;

	КонецПопытки;
	ТекстПодсказки = Подсказка;
	НадоВыводитьПроценты = ВыводитьПроценты;
	НадоВыводитьНомерИКоличество = ВыводитьНомерИКоличество;
	НадоВыводитьВремя = ВыводитьВремя;
	КоличествоШаговПрогресса = Число(КоличествоШагов);
	Если КоличествоШаговПрогресса < 0 Тогда
		
		ВызватьИсключение "Количество шагов должно быть больше 0";
		
	КонецЕсли;
	
	ПоследнийШаг = 0;
	ДатаНачала = ТекущаяДата();
	Длительность = 0;
	Инициализирован = Истина;
	
КонецПроцедуры // Начать

// СделатьШаг
//	Двигает строку прогресса на шаг в перед. Предоставляется возможность управлять
//	размером шага, общим количеством и подсказкой
//
// Параметры:
//	Инкремент 			- Число 	- Размер и направление (для отрицательных значений) шага
//  КоличествоШагов 	- Число 	- Общее количество шагов прогресса
//	Подсказка 			- Строка 	- Текст, выводимый перед строкой прогресса
//
Процедура СделатьШаг(Инкремент = 1, КоличествоШагов = 0, Подсказка = Неопределено) Экспорт
	
	Если Не Инициализирован Тогда
		
		ВызватьИсключение "Прогресс бар не инициализирован. Воспользуйтесь методом Начать";
		
	КонецЕсли;
	
	Если КоличествоШагов > 0 Тогда
		
		КоличествоШаговПрогресса = КоличествоШагов;
		
	КонецЕсли;
	
	ПоследнийШаг = ПоследнийШаг + Инкремент;
	Если ПоследнийШаг < 0 Тогда
		
		ПоследнийШаг = 0;
		
	ИначеЕсли ПоследнийШаг > КоличествоШаговПрогресса Тогда
		
		ПоследнийШаг = КоличествоШаговПрогресса;
		
	КонецЕсли;
	
	Если Подсказка <> Неопределено Тогда

		ТекстПодсказки = Подсказка;

	КонецЕсли;

	Длительность = ТекущаяДата() - ДатаНачала;

	Нарисовать();

КонецПроцедуры // СделатьШаг

// Нарисовать
//	Рисует строку прогресса, если консоль это позволяет.
//
//	Управление курсором работает только в живой консоли: при перенаправленном выводе
//	позиция курсора недоступна (на Windows - "The handle is invalid"), а в сборке окна
//	нет вовсе и его ширина равна нулю. Прогресс-бар - украшение, и из-за него работа
//	падать не должна: если рисовать нельзя, бар молча замолкает до конца прогона,
//	а счётчик шагов и длительность продолжают считаться.
//
Процедура Нарисовать()

	Если Не ВыводВозможен Тогда

		Возврат;

	КонецЕсли;

	Попытка

		НарисоватьСтроку();

	Исключение

		ВыводВозможен = Ложь;

	КонецПопытки;

КонецПроцедуры // Нарисовать()

Процедура НарисоватьСтроку()

	СкрытьКурсор(Ложь);
	Консоль.КурсорЛево = 0;
	Для Ит = 1 По Консоль.Ширина - 1 Цикл

		Консоль.Вывести(" ");

	КонецЦикла;
	Консоль.КурсорЛево = 0;

	// Подписи считаются до отрисовки: по ним видно, сколько места остаётся бару.
	// Не уместившийся в ширину бар терминал переносит на следующую строку, и очистка
	// следующего кадра стирает только её - предыдущая остаётся на экране, а вместо
	// строки прогресса получается лестница из хвостов
	ТекстНомера = ?(НадоВыводитьНомерИКоличество,
		СтрШаблон("(%1 из %2) ", ПоследнийШаг, КоличествоШаговПрогресса),
		"");

	ТекстПроцентов = ?(НадоВыводитьПроценты,
		"" + Цел(ПоследнийШаг / КоличествоШаговПрогресса * 100) + "% ",
		"");

	Если НадоВыводитьВремя Тогда

		ДлительностьСтрока = ВремяВСтроку(Длительность);
		Прогноз = (Длительность * КоличествоШаговПрогресса) / ПоследнийШаг - Длительность;
		ТекстВремени = "t " + ДлительностьСтрока + " ~" + ВремяВСтроку(Прогноз);

	Иначе

		ТекстВремени = "";

	КонецЕсли;

	// 5 - это значок, пробел и рамка бара из двух вертикальных черт с пробелом
	ЗанятоПодписями = СтрДлина(ТекстПодсказки) + СтрДлина(ТекстНомера)
		+ СтрДлина(ТекстПроцентов) + СтрДлина(ТекстВремени) + 5;

	ДлинаБара = ДлинаБара(ЗанятоПодписями);

	Если ЗначениеЗаполнено(ТекстПодсказки) Тогда

		Консоль.ЦветТекста = ЦветКонсоли.Green;
		Консоль.Вывести(ТекстПодсказки);

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстНомера) Тогда

		Консоль.ЦветТекста = ЦветКонсоли.Yellow;
		Консоль.Вывести(ТекстНомера);

	КонецЕсли;

	Консоль.ЦветТекста = ЦветБара;

	Позиция = Цел(ПоследнийШаг / КоличествоШаговПрогресса * ДлинаБара);

	Значек = Сред("/-\|", ПоследнийШаг % 4 + 1, 1);
	СтрокаЗаполненногоПрогресса = Сред(СтрокаЗаполненногоБара, 1, Позиция);
	СтрокаНеЗаполненногоПрогресса = Сред(СтрокаПустогоБара, 1, ДлинаБара - Позиция);

	Консоль.Вывести(СтрШаблон("%1 |%2%3| ", Значек, СтрокаЗаполненногоПрогресса, СтрокаНеЗаполненногоПрогресса));

	Если ЗначениеЗаполнено(ТекстПроцентов) Тогда

		Консоль.ЦветТекста = ЦветКонсоли.Yellow;
		Консоль.Вывести(ТекстПроцентов);

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстВремени) Тогда

		Консоль.ЦветТекста = ЦветКонсоли.Yellow;
		Консоль.Вывести("t ");
		Консоль.ЦветТекста = ЦветКонсоли.Cyan;
		Консоль.Вывести(Сред(ТекстВремени, 3));

	КонецЕсли;

	СкрытьКурсор(Истина);
	Консоль.ЦветТекста = ЦветТекстаКонсоли;

КонецПроцедуры // НарисоватьСтроку()

// Завершить
//	Завершает вывод строки прогресс бара
//
Процедура Завершить() Экспорт

	Инициализирован = Ложь;
	Длительность = ТекущаяДата() - ДатаНачала;

	Если Не ВыводВозможен Тогда

		Возврат;

	КонецЕсли;

	Попытка

		СкрытьКурсор(Истина);
		Консоль.ЦветТекста = ЦветТекстаКонсоли;
		Консоль.ВывестиСтроку("");

	Исключение

		ВыводВозможен = Ложь;

	КонецПопытки;

КонецПроцедуры // Завершить

// ДлительностьВыполнения
//	Возвращает время, прошедшее с момента начала работы. Отсечка времени идет на момент последнего шага / либо завершения
//
// Параметры:
//  ВВидеПредставления - Булево - Признак возврата времени в человеко-читаемом строковом виде, иначе число 
//
// Возвращаемое значение:
//   Число, Строка - Время, прошедшее с начала работы
//
Функция ДлительностьВыполнения(ВВидеПредставления = Ложь) Экспорт
	
	Если ВВидеПредставления Тогда

		Возврат ВремяВСтроку(Длительность);

	Иначе

		Возврат Длительность;

	КонецЕсли;

КонецФункции // ДлительностьВыполнения()

// УстановитьСимволыБара
//	Позволяет устанавливать символы исаользуемые для формирования бара.
//
// Параметры:
//  СимволПустогоБара - Строка - Символ для формирования пустой части бара
//  СимволЗаполненногоБара - Строка - Символ для формирования закрашенной части бара
//
Процедура УстановитьСимволыБара(СимволПустогоБара = " ", СимволЗаполненногоБара = "-") Экспорт 
	
	// Заготовки строятся на самый широкий бар: узкая консоль берёт от них начало
	СтрокаПустогоБара = ЗаполнитьБар(СимволПустогоБара, ДлинаБараПоУмолчанию);
	СтрокаЗаполненногоБара = ЗаполнитьБар(СимволЗаполненногоБара, ДлинаБараПоУмолчанию);

КонецПроцедуры // УстановитьСимволыБара()

// УстановитьЦветБара
//	Устанавливает цвет прогрессбара.
//
// Параметры:
//  Цвет - ЦветКонсоли - Цвет выводимого прогрессбара
//
Процедура УстановитьЦветБара(Цвет) Экспорт

	ЦветБара = Цвет;

КонецПроцедуры	// УстановитьЦветБара()

///////////////////////////////////////////////////////////////////////////////

Функция ВремяВСтроку(Знач Время)
	
	ВремяСтрока = "";
	Если Время > 86400 Тогда
		
		ВремяСтрока = ВремяСтрока + Цел(Время / 86400) + "д ";
		Время = Время % 86400;
		
	КонецЕсли;
	
	Если Время > 3600 Тогда
		
		ВремяСтрока = ВремяСтрока + Цел(Время / 3600) + "ч ";
		Время = Время % 3600;
		
	КонецЕсли;
	
	Если Время > 60 Тогда
		
		ВремяСтрока = ВремяСтрока + Цел(Время / 60) + "м ";
		Время = Время % 60;
		
	КонецЕсли;
	
	ВремяСтрока = ВремяСтрока + Цел(Время) + "с";
	
	Возврат ВремяСтрока;
	
КонецФункции // ВремяВСтроку()

// СкрытьКурсор
//	Управляет видимостью курсора там, где это поддерживается.
//
//	Консоль.ВидимостьКурсора возвращает прежнее значение курсора, а для этого читает
//	Console.CursorVisible - свойство, чтение которого существует только на Windows.
//	На Linux и macOS вызов выбрасывает PlatformNotSupportedException, и прогресс-бар
//	падал на первом же шаге. Курсор там просто остаётся видимым.
//
// Параметры:
//  Видимость - Булево - Истина, если курсор должен быть виден
//
Процедура СкрытьКурсор(Знач Видимость)

	Если Не КурсорУправляем Тогда

		Возврат;

	КонецЕсли;

	Попытка

		Консоль.ВидимостьКурсора(Видимость);

	Исключение

		КурсорУправляем = Ложь;

	КонецПопытки;

КонецПроцедуры // СкрытьКурсор()

// ДлинаБара
//	Возвращает длину бара, при которой строка помещается в ширину консоли.
//
//	Полная ширина не занимается: последняя колонка оставляется пустой, иначе вывод
//	в неё сам по себе переводит строку. Узкая консоль ужимает бар до минимума,
//	а неизвестная ширина оставляет прежние 50 - там, где ширину узнать нельзя,
//	перенос всё равно не грозит.
//
// Параметры:
//	ЗанятоПодписями - Число - Сколько символов строки занято всем, кроме самого бара
//
// Возвращаемое значение:
//	Число - Длина бара в символах
//
Функция ДлинаБара(Знач ЗанятоПодписями)

	Попытка
		ШиринаКонсоли = Консоль.Ширина;
	Исключение
		ШиринаКонсоли = 0;
	КонецПопытки;

	Возврат ДлинаБараДляШирины(ШиринаКонсоли, ЗанятоПодписями);

КонецФункции

// ДлинаБараДляШирины
//	Длина бара для заданной ширины консоли. Вынесена отдельно от чтения консоли,
//	чтобы проверяться без неё: в сборке консоли нет.
//
// Параметры:
//	ШиринаКонсоли 	- Число - Ширина консоли в символах, 0 - ширина неизвестна
//	ЗанятоПодписями - Число - Сколько символов строки занято всем, кроме самого бара
//
// Возвращаемое значение:
//	Число - Длина бара в символах
//
Функция ДлинаБараДляШирины(Знач ШиринаКонсоли, Знач ЗанятоПодписями) Экспорт

	Если ШиринаКонсоли <= 0 Тогда
		Возврат ДлинаБараПоУмолчанию;
	КонецЕсли;

	Возврат Макс(
		МинимальнаяДлинаБара,
		Мин(ДлинаБараПоУмолчанию, ШиринаКонсоли - 1 - ЗанятоПодписями));

КонецФункции

Функция ЗаполнитьБар(СимволШаблона, Длина = 50);

	МассивСимволов = Новый Массив;
	Для Ном = 1 По Длина Цикл
		МассивСимволов.Добавить(СимволШаблона);
	КонецЦикла;	

	Бар = СтрСоединить(МассивСимволов);

	Возврат Бар;

КонецФункции

Инициализирован = ЛОЖЬ;
Длительность = 0;
КурсорУправляем = ИСТИНА;
ВыводВозможен = ИСТИНА;
ДлинаБараПоУмолчанию = 50;
МинимальнаяДлинаБара = 10;
ЦветБара =  ЦветКонсоли.Magenta;
УстановитьСимволыБара();
