#Использовать asserts
#Использовать ".."

// Тесты прогресс-бара.
//
// Рисование проверяется наравне с остальным: в сборке вывод перенаправлен в файл,
// и бар должен переживать это на любой операционной системе.

Функция Бар()
	Возврат Новый ПрогрессБар();
КонецФункции

&Тест
Процедура ШагБезИнициализацииВыбрасываетИсключение() Экспорт

	Попытка
		Бар().СделатьШаг();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ИнформацияОбОшибке).Не_().ЭтоНеопределено();
	Ожидаем.Что(СтрНайти(ИнформацияОбОшибке.Описание, "не инициализирован")).Больше(0);

КонецПроцедуры

&Тест
Процедура ОтрицательноеЧислоШаговВыбрасываетИсключение() Экспорт

	Попытка
		Бар().Начать(-1);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	КонецПопытки;

	Ожидаем.Что(ИнформацияОбОшибке).Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ДлительностьВыполненияЧитаетсяВЧисленномВиде() Экспорт

	Ожидаем.Что(Бар().ДлительностьВыполнения()).Равно(0);

КонецПроцедуры

&Тест
Процедура ДлительностьВыполненияЧитаетсяВПредставлении() Экспорт

	Ожидаем.Что(Бар().ДлительностьВыполнения(Истина)).Равно("0с");

КонецПроцедуры

&Тест
Процедура ШагиДоходятДоКонцаБара() Экспорт

	// Регрессия: на Linux и macOS первый же шаг падал с PlatformNotSupportedException -
	// видимость курсора там прочитать нельзя

	ПрогрессБар = Бар();
	ПрогрессБар.Начать(3, "Проба");

	Для Сч = 1 По 3 Цикл
		ПрогрессБар.СделатьШаг();
	КонецЦикла;

	ПрогрессБар.Завершить();

	Ожидаем.Что(ПрогрессБар.ДлительностьВыполнения()).БольшеИлиРавно(0);

КонецПроцедуры

&Тест
Процедура БарУжимаетсяПодУзкуюКонсоль() Экспорт

	// Не уместившуюся строку терминал переносит, а очистка следующего кадра стирает
	// только последнюю строку - предыдущая остаётся на экране, и вместо прогресса
	// получается лестница из хвостов

	// подписи занимают 45 символов из 80, последняя колонка не занимается
	Ожидаем.Что(Бар().ДлинаБараДляШирины(80, 45), "Бар в узкой консоли")
		.Равно(34);

КонецПроцедуры

&Тест
Процедура БарНеРастетШире50() Экспорт

	// Широкая консоль бар не растягивает: привычный размер остаётся прежним

	Ожидаем.Что(Бар().ДлинаБараДляШирины(200, 45), "Бар в широкой консоли")
		.Равно(50);

КонецПроцедуры

&Тест
Процедура БарНеСхлопываетсяВНичто() Экспорт

	// Подписи бывают шире всей консоли. Бар тогда бесполезен, но и рисовать
	// отрицательное число символов нельзя

	Ожидаем.Что(Бар().ДлинаБараДляШирины(30, 45), "Бар в очень узкой консоли")
		.Равно(10);

КонецПроцедуры

&Тест
Процедура БезИзвестнойШириныБарПрежний() Экспорт

	// В сборке ширины нет, но там и переноса не будет: вывод идёт в файл

	Ожидаем.Что(Бар().ДлинаБараДляШирины(0, 45), "Бар при неизвестной ширине")
		.Равно(50);

КонецПроцедуры

&Тест
Процедура СимволыИЦветБараНастраиваются() Экспорт

	ПрогрессБар = Бар();
	ПрогрессБар.УстановитьСимволыБара(".", "#");
	ПрогрессБар.УстановитьЦветБара(ЦветКонсоли.Blue);
	ПрогрессБар.Начать(2, "Проба");
	ПрогрессБар.СделатьШаг();
	ПрогрессБар.Завершить();

	Ожидаем.Что(ПрогрессБар.ДлительностьВыполнения()).БольшеИлиРавно(0);

КонецПроцедуры
